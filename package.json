{
  "name": "@griddynamics/gd-design-system",
  "version": "1.0.0",
  "license": "MIT",
  "homepage": "https://github.com/griddynamics/gd-design-system#readme",
  "keywords": [
    "design-system",
    "react",
    "components",
    "design-tokens",
    "ai-schemas",
    "gridkit"
  ],
  "bin": {
    "create-component": "./bin/create-component.js"
  },
  "scripts": {
    "test": "nx test ui --coverage --watch=false",
    "test:ai": "nx test ui --run src/ai/__tests__",
    "test:ai:watch": "nx test ui src/ai/__tests__",
    "test:form-configurator": "nx run-many --target=test --projects=form-configurator-core,form-configurator-adapter-react --coverage --watch=false",
    "type-check": "nx run-many --target=typecheck --projects=ui",
    "update-readme-stats": "node libs/ui/scripts/update-readme-stats.mjs",
    "check:readme-stats": "node libs/ui/scripts/update-readme-stats.mjs --check",
    "verify:ui:run": "concurrently --group --kill-others-on-fail=false --names=api,knip,tree,agadoo,lint,ssr,cjs,attw,size,rsc -c=cyan,magenta,yellow,green,blue,red,gray,white,bgBlue,bgMagenta \"node libs/ui/scripts/audit-api.mjs --json\" \"node libs/ui/scripts/knip-check.mjs --json\" \"node libs/ui/scripts/treeshake-check.mjs --json\" \"node libs/ui/scripts/agadoo-check.mjs --json\" \"node libs/ui/scripts/build-lint.mjs --json\" \"node libs/ui/scripts/ssr-check.mjs --json\" \"node libs/ui/scripts/cjs-check.mjs --json\" \"node libs/ui/scripts/attw-check.mjs --json\" \"node libs/ui/scripts/size-check.mjs --json\" \"node libs/ui/scripts/rsc-render-check.mjs --json\"",
    "verify:ui": "npm run verify:ui:run && node libs/ui/scripts/build-summary.mjs",
    "verify:ui:ci": "npm run verify:ui:run && node libs/ui/scripts/build-summary.mjs --check",
    "verify:ui:install": "node libs/ui/scripts/install-check.mjs --json && node libs/ui/scripts/build-summary.mjs",
    "verify:ui:full": "npm run verify:ui:run && node libs/ui/scripts/install-check.mjs --json && node libs/ui/scripts/build-summary.mjs",
    "build:ui": "npm run check:readme-stats && npm run generate-ai-docs && npm run type-check && nx lint ui && nx build ui && cp libs/ui/package.json dist/libs/ui/package.json && node libs/ui/scripts/postbuild-types.mjs",
    "build:form-configurator": "npm run type-check && nx run-many --target=lint --projects=form-configurator-core,form-configurator-adapter-react && nx run-many --target=build --projects=form-configurator-core,form-configurator-adapter-react",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "format": "prettier --write . | grep -v '(unchanged)' | tee prettier-changes.log && echo \"Total files formatted: $(cat prettier-changes.log | wc -l)\"",
    "format:check": "prettier --check .",
    "storybook": "npm run export-theme && nx run ui:storybook -- --port 6006",
    "storybook:test": "nx test ui -- --project storybook --run",
    "storybook:visual": "nx test ui -- --project visual --run",
    "publish:ui": "npm publish dist/libs/ui",
    "publish:form-configurator-core": "npm publish dist/libs/form-configurator",
    "publish:form-configurator-react": "npm publish dist/libs/form-configurator/adapter-react",
    "publish:form-configurator": "npm run publish:form-configurator-core && npm run publish:form-configurator-react",
    "version:form-configurator": "npm version patch --prefix libs/form-configurator/core --no-git-tag-version && npm version patch --prefix libs/form-configurator/adapter-react --no-git-tag-version",
    "version:form-configurator:minor": "npm version minor --prefix libs/form-configurator/core --no-git-tag-version && npm version minor --prefix libs/form-configurator/adapter-react --no-git-tag-version",
    "version:form-configurator:major": "npm version major --prefix libs/form-configurator/core --no-git-tag-version && npm version major --prefix libs/form-configurator/adapter-react --no-git-tag-version",
    "build-storybook": "npm run export-theme && nx run ui:build-storybook",
    "crc": "node ./bin/create-component.js",
    "export-theme": "nx build ui && node ./bin/export-theme.js",
    "generate-ai-docs": "npx tsx ./bin/generate-ai-docs.mjs",
    "prepare": "husky"
  },
  "overrides": {
    "@types/react": "^18.3.18"
  },
  "private": true,
  "workspaces": [
    "libs/ui",
    "libs/form-configurator/core",
    "libs/form-configurator/adapter-react"
  ],
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "core-js": "^3.36.1",
    "embla-carousel-react": "^8.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "use-sync-external-store": "^1.5.0",
    "uuid": "^14.0.0",
    "zustand": "^5.0.6"
  },
  "engines": {
    "npm": ">=9.8.1",
    "node": ">=22.17.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@arethetypeswrong/cli": "^0.18.2",
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/css": "^11.13.5",
    "@eslint/js": "^9.17.0",
    "@nx/eslint": "22.7.2",
    "@nx/eslint-plugin": "22.7.2",
    "@nx/jest": "22.7.2",
    "@nx/js": "22.7.2",
    "@nx/react": "22.7.2",
    "@nx/storybook": "22.7.2",
    "@nx/vite": "22.7.2",
    "@nx/workspace": "22.7.2",
    "@rolldown/plugin-babel": "^0.2.0",
    "@rollup/plugin-url": "^8.0.2",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-onboarding": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/builder-vite": "^10.3.5",
    "@storybook/jest": "^0.2.3",
    "@storybook/react-vite": "^10.3.5",
    "@svgr/rollup": "^8.1.0",
    "@swc-node/register": "^1.11.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.8",
    "@swc/helpers": "~0.5.11",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.13.1",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser": "4.1.8",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/ui": "4.1.8",
    "agadoo": "^3.0.0",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.2.1",
    "cytoscape": "^3.33.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.0",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-storybook": "^10.3.5",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "inquirer": "^8.2.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jsdom": "^26.1.0",
    "knip": "^6.12.0",
    "lint-staged": "^15.5.0",
    "madge": "^8.0.0",
    "markdownlint-cli": "^0.45.0",
    "nx": "22.7.2",
    "path": "^0.12.7",
    "playwright": "^1.56.1",
    "prettier": "^3.4.2",
    "remark-gfm": "^4.0.1",
    "rollup": "^4.60.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "rollup-preserve-directives": "^1.1.3",
    "sass": "^1.55.0",
    "size-limit": "^12.1.0",
    "storybook": "^10.3.5",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "verdaccio": "^6.0.5",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^4.5.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.1.8"
  },
  "lint-staged": {
    "libs/**/*.{ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "libs/**/*.{js,jsx,json,md}": [
      "prettier --write"
    ],
    "**/*.md": [
      "markdownlint --dot --fix"
    ]
  },
  "nx": {
    "includedScripts": []
  }
}
