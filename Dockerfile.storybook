FROM node:24-alpine AS build
WORKDIR /app

COPY package.json package-lock.json nx.json tsconfig.base.json .npmrc eslint.config.mjs ./
COPY libs/ui/ libs/ui/
COPY libs/design-core/ libs/design-core/
COPY libs/web-components/ libs/web-components/
COPY libs/form-configurator/ libs/form-configurator/
COPY libs/react-native/package.json libs/react-native/package.json
COPY bin/ bin/
COPY README.md CLAUDE.md ./

RUN npm ci

RUN npm run build-storybook

FROM nginx:alpine AS runner
WORKDIR /usr/share/nginx/html

COPY --from=build /app/libs/ui/storybook-static/ .
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
