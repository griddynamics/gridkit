{
  "name": "gd-design-library",
  "version": "1.8.3",
  "license": "MIT",
  "type": "module",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "files": [
    "**",
    "!stories/**"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./styles.css": "./styles.css",
    "./llms.txt": "./llms.txt",
    "./ai": {
      "types": "./ai/index.d.ts",
      "import": "./ai/index.js",
      "require": "./ai/index.cjs"
    },
    "./ai/ui-specification-schema.json": "./ai/a2ui/ui-specification-schema.json",
    "./renderer": {
      "types": "./utils/a2ui/index.d.ts",
      "import": "./utils/a2ui/index.js",
      "require": "./utils/a2ui/index.cjs"
    },
    "./tokens": {
      "types": "./tokens/index.d.ts",
      "import": "./tokens/index.js",
      "require": "./tokens/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "renderer": ["./utils/a2ui/index.d.ts"]
    }
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "embla-carousel": "^8.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "embla-carousel": {
      "optional": true
    }
  },
  "dependencies": {
    "@react-spring/web": "^10.1.2",
    "@visx/curve": "^3.12.0",
    "embla-carousel-react": "^8.6.0",
    "@visx/gradient": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@visx/tooltip": "^3.12.0",
    "@visx/xychart": "^3.12.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0"
  }
}
