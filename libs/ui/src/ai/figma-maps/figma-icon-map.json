  "$usage": {
    "keyQuestion": "What GridKit icon key corresponds to this Figma icon name, and vice versa?",
    "lookupSteps": [
      "1. Figma → GridKit (most common): query figmaNameIndex[figmaName] → GridKit key. E.g. figmaNameIndex['close'] → 'cross'.",
      "2. GridKit → Figma: find icons[key].figmaName. E.g. icons['cross'].figmaName → 'close'.",
      "3. If figmaName is null in icons[key]: this is a custom GridKit SVG with no Figma equivalent — use the key as-is.",
      "4. In A2UI specs: use the GridKit key as the icon name value. Validate against A2UI_AVAILABLE_ICONS before using."
    ],
    "criticalRules": [
      "Always use the GridKit key (e.g. 'cross') in generated code, never the Figma snake_case name ('close').",
      "8 custom icons have no Figma equivalent: success, error, warning, info, dot, slash, ruler, processing.",
      "54 total icons; 46 map to Figma Material icons. figmaNameIndex has 48 forward-lookup entries."
    ]
