{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Figma variable name → GridKit token. Source: libs/ui/src/tokens/font.ts + Figma file bCDJhVLlAFSIZtPFbEwDRO node 2:3. CRITICAL: font tokens are NOT CSS custom properties — never emit var(--gds-font-*) in TSX. All values come from useTheme(). Access lineHeight as theme.font?.line?.height?.h5 (three levels deep), NEVER theme.font?.lineHeight?.h5.",
  "$usage": {
    "keyQuestion": "What GridKit font token corresponds to this Figma typography variable or value?",
    "lookupSteps": [
      "1. Figma variable name (camelCase): split → fontSizeH5→font.size.h5, lineHeightH5→font.line.height.h5, fontWeightBold→font.weight.bold, fontFamily→font.family. See camelCaseSplitExamples.",
      "2. Value only: query valueIndex.fontSize['20px'], valueIndex.lineHeight['26px'], or valueIndex.fontWeight['400'].",
      "3. Check knownGaps before marking as unmatched — 34px lineHeight and fontWeight 800/900 are documented gaps.",
      "4. No match: record 'unmatched:<value>' in tokenBindings."
    ],
    "criticalRules": [
      "Font tokens are NOT CSS vars — never emit var(--gds-font-*) in TSX. Use useTheme() dot-paths for all font values.",
      "lineHeight path is 3 levels deep: font.line.height.<scale>. Access: theme.font?.line?.height?.h5. NEVER theme.font?.lineHeight?.h5.",
      "Use the raw CSS value in styling fields; record the token dot-path in tokenBindings.",
      "styleVariant='bold' = fontWeight 700. Never combine styleVariant='bold' with fontWeight override in styling.",
      "fontWeight 800/900 has no GridKit token — record as 'unmatched:800' in tokenBindings and use literal in styling."
    ]
  },
  "family": {
    "gds.font.family": {
      "tokenPath": "font.family",
      "themeAccess": "theme.font?.family",
      "value": "\"Fira Sans\", sans-serif"
    },
    "gds.font.family.code": {
      "tokenPath": "font.family.code",
      "themeAccess": "theme.font?.['family.code']",
      "value": "\"Fira Code\", Monaco"
    }
  },
