exports[`Textarea > SHOULD render helper text if provided 1`] = `
<div>
  <textarea
    aria-describedby=":r4:-helper"
    aria-invalid="false"
    aria-multiline="true"
    class="sc-kFXyV lcAiZM"
    data-testid="Textarea"
    id=":r4:"
    role="textbox"
  />
  <small
    class="css-1eif5ff"
    data-testid="typography"
    id=":r4:-helper"
  >
    This is helper text
  </small>
</div>
`;
