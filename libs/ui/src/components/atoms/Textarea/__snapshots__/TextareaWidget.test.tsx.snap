exports[`Textarea > SHOULD correctly track character count when maxLength is set 1`] = `
<div>
  <textarea
    aria-invalid="false"
    aria-multiline="true"
    class="sc-kFXyV lcAiZM"
    data-testid="Textarea"
    id=":r2:"
    maxlength="10"
    role="textbox"
  />
  <small
    class="textarea-char-counter css-1eif5ff"
    data-testid="typography"
    id=":r2:-char-counter"
  >
    5
     / 
    10
  </small>
</div>
`;

exports[`Textarea > SHOULD render correctly with label and default value 1`] = `
